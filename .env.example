# Окружение (development | production)
NODE_ENV=development
DB_HOST=localhost
DB_PORT=5434
DB_USER=alex
DB_PASSWORD=secret
DB_NAME=hw-1
PORT=3000
JWT_ACCESS_SECRET=замени-на-свой
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=замени-на-другой
JWT_REFRESH_EXPIRES_IN=7d

# Настройки MinIO / S3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=avatars
AVATAR_MAX_BYTES=10485760

REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
CACHE_TTL_MS=30000
REDIS_PORT=6379

# Настройки фоновой очистки
AVATAR_CLEANUP_CRON=0 3 * * *        # Каждый день в 03:00
AVATAR_CLEANUP_RETENTION_DAYS=7      # Хранить удаленные 7 дней